    /* Passo "mostrar_acordo_ativo" do backend: normaliza e usa a mesma tela. */
    function telaAcordoAtivo(data) {
        const ac = data?.acordoAtivo || {};
        const pres = getCredorPresentation(ac.credor || "", ac.unidade || "");
        const doPainel = credorConfig(ac.credor || "").nome;
        const parcelas = (Array.isArray(ac.parcelas) ? ac.parcelas : [])
            .map(row => normalizaLinha(row, "acordo"));
        abrirAcordo({
            /* o credor cru vai adiante: é ele que escolhe os canais da tela */
            credor: ac.credor || "",
            credorNome: doPainel || ac.credorNome || pres.nome,
            numeroContrato: ac.numeroContrato || "-",
            valorTotal: parseMoneyLike(ac.valorFormatado || ac.valor || 0),
            valorTotalFormatado: ac.valorFormatado || formatBRL(parseMoneyLike(ac.valor || 0)),
            valorNegociado: parseMoneyLike(ac.valorNegociadoFormatado || ac.valorNegociado || 0),
            chatUrl: data?.chatUrl || ac.chatUrl || pres.chat,
            parcelas,
            detalhes: parcelas.length ? parcelas : [normalizaLinha({
                vencimentoFormatado: ac.vencimentoFormatado || "--/--/----",
                valorFormatado: ac.valorFormatado || "R$ 0,00",
                valor: parseMoneyLike(ac.valor || 0)
            }, "acordo")],
            valorOriginal: 0, diasAtraso: 0
        });
    }

    /* ===================== valores ======================================== */
    function parseMoneyLike(v) {
        if (v === null || v === undefined || v === "") return 0;
        if (typeof v === "number") return Number.isFinite(v) ? v : 0;
        const s = String(v).trim(); if (!s) return 0;
        if (s.includes("R$") || s.includes(",")) {
            const n = Number(s.replace(/\s/g, "").replace(/R\$/g, "").replace(/\./g, "").replace(",", ".").replace(/[^\d.-]/g, ""));
            return Number.isFinite(n) ? n : 0;
        }
        const digits = s.replace(/[^\d-]/g, "");
        if (/^-?\d+$/.test(digits)) {
            const intVal = Number(digits);
            if (!Number.isFinite(intVal)) return 0;
            if (Math.abs(intVal) >= 10000 && !s.includes(".")) return intVal / 100;
            return intVal;
        }
        const fb = Number(s.replace(/[^\d.-]/g, ""));
        return Number.isFinite(fb) ? fb : 0;
    }

    function normalizeInstallmentData(parcelamento) {
        const parcelasDisponiveis = Array.isArray(parcelamento?.parcelasDisponiveis)
            ? parcelamento.parcelasDisponiveis.map(Number).filter(q => Number.isFinite(q) && q >= 2) : [];
        const valorNegociadoParcelado = parseMoneyLike(
            parcelamento?.valorNegociadoParceladoFormatado || parcelamento?.valorNegociadoParcelado || 0);
        return {
            ...parcelamento, valorNegociadoParcelado,
            valorNegociadoParceladoFormatado: parcelamento?.valorNegociadoParceladoFormatado || formatBRL(valorNegociadoParcelado),
            parcelasDisponiveis,
            valorMinimoParcela: Number(parcelamento?.valorMinimoParcela || 100),
            percentualDescontoVista: Number(parcelamento?.percentualDescontoVista || 0),
            percentualDescontoParcelado: Number(parcelamento?.percentualDescontoParcelado || 0)
        };
    }

    /* Uma linha de detalhe — nota em atraso, parcela de acordo ou ordem de
       serviço — sempre normalizada do mesmo jeito, venha de "detalhes" ou de
       "parcelas".                                                             */
    function normalizaLinha(row, tipo) {
        if (tipo === "ira") {
            return {
                placa: row?.placa || row?.Placa || row?.numeroDocumento || "-",
                os: row?.os || row?.OS || row?.IraOS || "-",
                dataOS: row?.dataOS || row?.DataOS || row?.vencimentoFormatado || "-"
            };
        }
        const valorDetalhe = parseMoneyLike(row?.valorFormatado || row?.valor || 0);
        return {
            numero: row?.numeroDocumento || row?.numero || row?.nota || "",
            vencimento: row?.vencimento || "",
            vencimentoFormatado: row?.vencimentoFormatado || row?.vencimento || "-",
            valor: valorDetalhe,
            valorFormatado: row?.valorFormatado || formatBRL(valorDetalhe),
            /* status de pagamento: o acordo vigente precisa saber quais
               parcelas já foram pagas para calcular o saldo restante. */
            pago: row?.pago === true || /pag/i.test(String(row?.status || "")),
            status: row?.status || ""
        };
    }

    function normalizeCards(cards) {
        return (Array.isArray(cards) ? cards : []).map(c => {
            const pres = getCredorPresentation(c?.credor || "", c?.unidade || "");
            const tipo = String(c?.tipo || "pendencia").toLowerCase();
            const detalhes = (Array.isArray(c?.detalhes) ? c.detalhes : []).map(row => normalizaLinha(row, tipo));
            /* Acordo: o backend pode mandar as parcelas em "parcelas" em vez de
               "detalhes". As duas formas chegam iguais na tela.               */
            const parcelas = (Array.isArray(c?.parcelas) ? c.parcelas : []).map(row => normalizaLinha(row, tipo));
            const valorTotal = parseMoneyLike(c?.valorTotalFormatado || c?.valorTotal || 0);
            const propostaQuitacao = parseMoneyLike(c?.propostaQuitacaoFormatada || c?.propostaQuitacao || 0);
            /* Nome exibido: o que está cadastrado no painel para aquele credor
               manda. Sem cadastro, usa o que o backend enviou; em último caso,
               o nome cru. O cliente nunca deve ver nomenclatura de CRM.       */
            const doPainel = credorConfig(c?.credor || "").nome;
            const nomeCru = norm(c?.credorNome || "");
            const nomeBom = doPainel
                || ((!nomeCru || nomeCru === norm(c?.credor || "")) ? pres.nome : c.credorNome);
            return {
                tipo, credor: c?.credor || "", credorNome: nomeBom,
                logo: c?.logo || pres.logo, chatUrl: c?.chatUrl || pres.chat,
                numeroContrato: c?.numeroContrato || "-", idContrato: c?.idContrato || "",
                unidade: c?.unidade || "",
                valorTotal, valorTotalFormatado: c?.valorTotalFormatado || formatBRL(valorTotal),
                propostaQuitacao, propostaQuitacaoFormatada: c?.propostaQuitacaoFormatada || formatBRL(propostaQuitacao),
                valorOriginal: parseMoneyLike(c?.valorOriginal || 0),
                valorNegociado: parseMoneyLike(c?.valorNegociadoFormatado || c?.valorNegociado || 0),
                diasAtraso: Number(c?.diasAtraso || 0),
                exibirProposta: c?.exibirProposta === true,
                tipoAcao: c?.tipoAcao || pres.tipoAcao,
                podeNegociar: c?.podeNegociar === true,
                permiteParcelamento: c?.permiteParcelamento === true,
                permiteSegundaVia: c?.permiteSegundaVia === true || c?.segundaVia === true || c?.tipoAcao === "SEGUNDA_VIA",
                maiorValor: c?.maiorValor === true,
                parcelamento: normalizeInstallmentData(c?.parcelamento || {}),
                detalhes, parcelas
            };
        });
    }

    function isAmilOperadoras(c) { return norm(c).includes("AMIL OPERADORAS"); }
    function borderBoxSH(c) { return norm(c).includes("SANTA HELENA"); }
    function isCredorSegundaVia(c) { return isAmilOperadoras(c) || borderBoxSH(c); }

    function shouldShowSecondCopy(card) {
        if (String(card?.tipo || "").toLowerCase() === "acordo") return false;
        const valorTotal = Number(card?.valorTotal || 0);
        return isCredorSegundaVia(card?.credor || card?.credorNome || "")
            && card?.podeNegociar !== true && valorTotal > 0 && valorTotal < 300;
    }

    function resolveCardActions(card) {
        const isAgreement = String(card?.tipo || "").toLowerCase() === "acordo";
        const pres = getCredorPresentation(card?.credor || "", card?.unidade || "");
        if (isAgreement) return { canNegotiate: false, canSchedule: false, canHuman: true, chatUrl: card?.chatUrl || pres.chat };
        const canNegotiate = card?.podeNegociar === true;
        const canSchedule = !canNegotiate && (card?.tipoAcao || pres.tipoAcao) === "AGENDAR";
        const canSecondCopy = !canNegotiate && !canSchedule && shouldShowSecondCopy(card);
        return { canNegotiate, canSchedule, canSecondCopy, canHuman: true, chatUrl: card?.chatUrl || pres.chat };
    }

    /* ===================== datas ========================================== */
    function getBusinessDates(count = 5) {
        const dates = []; const cursor = new Date();
        cursor.setHours(0, 0, 0, 0); cursor.setDate(cursor.getDate() + 1);
        while (dates.length < count) {
            const day = cursor.getDay();
            if (day !== 0 && day !== 6) dates.push(new Date(cursor));
            cursor.setDate(cursor.getDate() + 1);
        }
        return dates;
    }
    function formatDateInput(date) {
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
    }
    const DIAS_SEM = ["dom", "seg", "ter", "qua", "qui", "sex", "sáb"];
    const MESES = ["jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"];

    /* O cliente não escolhe data livre: escolhe entre os 5 próximos dias
       úteis. A trava da regra fica na própria tela.                          */
    function setupNegotiationCalendar() {
        const box = $("paymentDateOptions"); const hidden = $("paymentDateInput");
        if (!box || !hidden) return;
        const datas = getBusinessDates(5);
        box.innerHTML = datas.map((d, i) =>
            `<button aria-pressed="${i === 0}" class="opt" type="button" data-iso="${formatDateInput(d)}">` +
            `<small>${DIAS_SEM[d.getDay()]}</small><b>${String(d.getDate()).padStart(2, "0")}</b>` +
            `<i>${MESES[d.getMonth()]}</i></button>`).join("");
        hidden.value = formatDateInput(datas[0]);
    }

    $("paymentDateOptions")?.addEventListener("click", (ev) => {
        const b = ev.target.closest(".opt"); if (!b) return;
        const box = $("paymentDateOptions");
        box.querySelectorAll(".opt").forEach(o => o.setAttribute("aria-pressed", String(o === b)));
        $("paymentDateInput").value = b.dataset.iso;
        hideText("negotiationError");
    });

    /* ===================== pendências (cards) ============================= */
    function renderCards(cards) {
        const grid = $("cardsGrid"); if (!grid) return;
        grid.innerHTML = "";
        const normalized = normalizeCards(cards);

        const title = $("cardsTitle"); const subtitle = $("cardsSubtitle");
        const abertos = normalized.filter(c => c.tipo !== "acordo").length;
        if (title) title.textContent = "Suas pendências";
        if (subtitle) {
            subtitle.innerHTML = abertos
                ? `Total: <b>${abertos} em aberto</b> · valores atualizados agora`
                : "Valores atualizados nesta consulta.";
        }

        normalized.forEach(card => {
            const isAgreement = card.tipo === "acordo";
            const isLogistica = card.tipo === "ira";
            const actions = resolveCardActions(card);
            const isPremium = !isAgreement && !isLogistica && (
                card.maiorValor === true || card.tipo === "premium" ||
                card.tipoAcao === "HUMANO_PREMIUM" || Number(card.valorTotal || 0) >= 15000);
            const showProposal = !isAgreement && card.exibirProposta === true && card.podeNegociar === true;

            const art = document.createElement("article");
            art.className = "pend";

            /* topo: logo em linha própria (quando existir) e o nome do credor */
            const topo = document.createElement("div");
            topo.className = "pend-topo";
            const id = document.createElement("div");
            id.className = "pend-id";
            if (card.logo) {
                const img = document.createElement("img");
                img.className = "logo-credor";
                img.alt = card.credorNome;
                img.src = card.logo;
                img.onerror = () => img.remove();
                id.appendChild(img);
            }
            const nome = document.createElement("div");
            nome.className = "pend-credor";
            nome.textContent = card.credorNome;
            id.appendChild(nome);
            topo.appendChild(id);

            const seta = document.createElement("button");
            seta.type = "button"; seta.className = "pend-abrir";
            seta.setAttribute("aria-label", "Ver detalhes");
            seta.innerHTML = '<svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M9 18l6-6-6-6"></path></svg>';
            topo.appendChild(seta);
            art.appendChild(topo);

            /* valor */
            const bloco = document.createElement("div");
            if (isLogistica) {
                bloco.innerHTML = `<p class="de">Ordens de serviço</p>` +
                    `<div class="por"><b>${(card.detalhes || []).length}</b><em>equipamentos aguardando retirada</em></div>`;
            } else if (isAgreement) {
                bloco.innerHTML = `<p class="de">Parcela atual</p>` +
                    `<div class="por"><b>${card.valorTotalFormatado}</b></div>` +
                    `<div class="linha-eco"><span class="mini">Vence em ${card.detalhes?.[0]?.vencimentoFormatado || "--/--/----"}</span></div>`;
            } else if (showProposal) {
                const eco = Math.max(0, card.valorTotal - card.propostaQuitacao);
                const pct = card.valorTotal > 0 ? Math.round((eco / card.valorTotal) * 100) : 0;
                bloco.innerHTML = `<p class="de">De <s>${card.valorTotalFormatado}</s> por</p>` +
                    `<div class="por"><b>${card.propostaQuitacaoFormatada}</b><em>à vista</em></div>` +
                    (eco > 0 ? `<div class="linha-eco"><span class="eco">Economize ${formatBRL(eco)}</span>` +
                    (pct > 0 ? `<span class="pct"><svg fill="none" height="11" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.6" viewBox="0 0 24 24" width="11"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>${pct}%</span>` : "") +
                    `</div>` : "");
            } else {
                bloco.innerHTML = `<p class="de">Valor atualizado</p>` +
                    `<div class="por"><b>${card.valorTotalFormatado}</b></div>` +
                    (isPremium ? `<div class="linha-eco"><span class="destaque-esp">Preparamos um atendimento especializado para você</span></div>` : "");
            }
            art.appendChild(bloco);

            /* ação principal do cartão — cada cartão é sua própria decisão */
            const btn = document.createElement("button");
            btn.type = "button"; btn.className = "btn btn-1";
            let irPara = null;

            /* Regra: nenhum cartão abre link externo direto. Todo cartão leva
               a uma tela do portal, onde ficam o detalhamento e os canais.    */
            if (isAgreement) {
                btn.textContent = "Ver meu acordo";
                irPara = () => abrirAcordo(card);
            } else if (isPremium) {
                btn.textContent = "Ver meu atendimento";
                irPara = () => abrirAtendimento(card, "especialista");
            } else if (actions.canNegotiate) {
                btn.textContent = "Negociar agora";
                irPara = () => openNegotiation(card);
            } else if (actions.canSchedule) {
                btn.textContent = "Solicitar agendamento";
                irPara = () => openIraSchedule(card);
            } else if (actions.canSecondCopy) {
                btn.textContent = "Emitir boleto";
                irPara = () => openSecondCopyNegotiation(card);
            } else {
                btn.textContent = "Ver meu atendimento";
                irPara = () => abrirAtendimento(card, "equipe");
            }
            btn.addEventListener("click", () => { if (!modoPreview) irPara(); });
            seta.addEventListener("click", () => { if (!modoPreview) irPara(); });
            art.appendChild(btn);

            grid.appendChild(art);
        });
    }

    /* ===================== atendimento (tela própria) ===================== */
    /* Duas variantes na mesma tela: valor alto (especialista já acionado) e
       carteira tratada pela equipe. Nenhuma das duas tem barra de ação — é
       tela de informação e canais, não de decisão de pagamento.               */
    function abrirAtendimento(card, variante) {
        selectedCard = card;
        lastHumanChat = card?.chatUrl || chatPadrao();
        window.montarCanais(card?.credor || "");
        const txts = (window.PORTAL_CONFIG || {}).textos || {};
        const esp = variante === "especialista";
        const t = $("atendimentoTitulo");
        const sub = $("atendimentoSub");
        if (t) t.textContent = esp
            ? (txts["titulo.vAtendimento.especialista"] || "Um especialista já foi acionado")
            : (txts["titulo.vAtendimento.equipe"] || "Atendimento com a nossa equipe");
        if (sub) sub.textContent = esp
            ? (txts["texto.vAtendimento.especialista"] || "Você vai receber um contato para a elaboração da melhor condição para o seu caso.")
            : (txts["texto.vAtendimento.equipe"] || "A condição deste contrato é montada junto com um atendente.");
        montarDetalhes(card, "atendimentoDetalhes");
        setActiveView("vAtendimento");
    }

    /* ===================== acordo vigente ================================= */
    /* Monta a tela a partir do cartão ou do payload de acordo ativo. O botão
       de 2ª via leva a uma tela de confirmação dentro do portal — antes ele
       abria o chat externo, o que fugia do fluxo combinado.                   */
    function abrirAcordo(origem) {
        const parcelas = Array.isArray(origem.parcelas) && origem.parcelas.length
            ? origem.parcelas
            : (Array.isArray(origem.detalhes) ? origem.detalhes : []);
        const credor = origem.credorNome || "-";
        const sub = $("activeAgreementSub");
        const dl = $("activeAgreementDados");
        const btn = $("btnAgreementHumano");
        const rotuloBtn = btn ? btn.querySelector("[data-txt]") : null;

        const ehPaga = (p) => p.pago === true || /pag/i.test(String(p.status || ""));
        const proxima = parcelas.find(p => !ehPaga(p)) || parcelas[0] || {};

        if (parcelas.length > 1) {
            const pagas = parcelas.filter(ehPaga).length;
            if (sub) sub.innerHTML = "<b>" + credor + "</b> · " + pagas + " de " + parcelas.length + " parcelas pagas";
            const restante = parcelas.filter(p => !ehPaga(p))
                .reduce((a, p) => a + Number(p.valor || 0), 0);
            dl.innerHTML = parcelas.map((p, i) =>
                "<li><dt>Parcela " + (i + 1) + " · " + (p.vencimentoFormatado || p.vencimento || "-") + "</dt>" +
                "<dd class=\"" + (ehPaga(p) ? "paga" : "") + "\">" +
