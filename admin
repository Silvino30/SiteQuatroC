            });
            foundRecord = data || {};

            if (data?.proximoStep === "nao_localizado") { window.montarCanais(""); return setActiveView("vNoRecord"); }
            if (data?.proximoStep === "bloqueado") {
                lastHumanChat = data?.chatUrl || chatPadrao();
                return setActiveView("vBlocked");
            }
            if (data?.proximoStep === "validar_codigo_contato") return abrirTelaCodigo(false);
            if (data?.proximoStep === "validar_identidade") {
                renderIdentityOptions(data?.options || [], data?.fullName || nome, data?.type || "CPF");
                return setActiveView("vConfirmName");
            }
            if (data?.proximoStep === "sem_pendencia") return telaSemPendencia();
            if (data?.proximoStep === "mostrar_acordo_ativo") return telaAcordoAtivo(data);
            if (data?.proximoStep === "mostrar_cards") {
                renderCards(data?.cards || []);
                return setActiveView("vNext");
            }
            telaErro(data?.mensagem);
        } catch (e) {
            telaErro();
        }
    });

    on("btnValidateCode", "click", async () => {
        hideText("validationCodeError");
        const codigo = onlyDigits(lerCodigo());
        if (codigo.length !== 6) return showText("validationCodeError", "Informe o código de 6 dígitos.");
        setActiveView("vLoading");
        try {
            const data = await callBackend("validar_codigo_contato", {
                documento: currentDoc, codigoValidacao: codigo,
                nomeInformado: $("nameInput")?.value.trim() || "",
                telefoneInformado: onlyDigits($("phoneInput")?.value || ""),
                emailInformado: $("emailInput")?.value.trim() || ""
            });
            foundRecord = { ...(foundRecord || {}), ...(data || {}) };

            if (data?.proximoStep === "codigo_invalido") {
                setActiveView("vValidateCode");
                $("codigoCaixa")?.classList.add("erro-cod");
                const restam = Number(data?.tentativasRestantes);
                showText("validationCodeError", Number.isFinite(restam) && restam > 0
                    ? (restam === 1 ? "Código incorreto. Você tem mais 1 tentativa." : `Código incorreto. Você tem ${restam} tentativas.`)
                    : (data?.mensagem || "Código incorreto. Confira e tente novamente."));
                caixasCodigo.forEach(c => c.value = "");
                sincronizaCodigo();
                caixasCodigo[0]?.focus();
                return;
            }
            if (data?.proximoStep === "bloqueado") {
                lastHumanChat = data?.chatUrl || chatPadrao();
                return setActiveView("vBlocked");
            }
            if (data?.proximoStep === "sessao_expirada") return telaSessaoExpirada();
            if (data?.proximoStep === "validar_identidade") {
                renderIdentityOptions(data?.options || [], data?.fullName || ($("nameInput")?.value.trim() || ""), data?.type || "CPF");
                return setActiveView("vConfirmName");
            }
            if (data?.proximoStep === "sem_pendencia") return telaSemPendencia();
            if (data?.proximoStep === "mostrar_acordo_ativo") return telaAcordoAtivo(data);
            if (data?.proximoStep === "mostrar_cards") { renderCards(data?.cards || []); return setActiveView("vNext"); }
            telaErro(data?.mensagem);
        } catch (e) {
            telaErro();
        }
    });

    on("btnResendCode", "click", async () => {
        if ($("btnResendCode")?.disabled) return;
        hideText("validationCodeError");
        setActiveView("vLoading");
        try {
            const data = await callBackend("reenviar_codigo_contato", {
                documento: currentDoc,
                nomeInformado: $("nameInput")?.value.trim() || "",
                telefoneInformado: onlyDigits($("phoneInput")?.value || ""),
                emailInformado: $("emailInput")?.value.trim() || ""
            });
            if (data?.proximoStep === "validar_codigo_contato") return abrirTelaCodigo(true);
            if (data?.proximoStep === "sessao_expirada") return telaSessaoExpirada();
            telaErro(data?.mensagem);
        } catch (e) {
            telaErro();
        }
    });

    function validatePaymentDate(dateStr) {
        if (!dateStr) return { ok: false, message: "Selecione a data de vencimento." };
        const allowed = getBusinessDates(5).map(formatDateInput);
        if (!allowed.includes(String(dateStr))) return { ok: false, message: "Selecione uma das datas disponíveis." };
        return { ok: true, message: "" };
    }

    function validateIraForm() {
        const a = {
            data1: $("iraDate1")?.value || "", hora1: $("iraTime1")?.value || "",
            data2: $("iraDate2")?.value || "", hora2: $("iraTime2")?.value || "",
            logradouro: $("iraStreet")?.value.trim() || "", numero: $("iraNumber")?.value.trim() || "",
            bairro: $("iraDistrict")?.value.trim() || "", cep: onlyDigits($("iraZip")?.value || ""),
            cidade: $("iraCity")?.value.trim() || "", referencia: $("iraReference")?.value.trim() || "",
            responsavel: $("iraResponsible")?.value.trim() || "", email: $("iraEmail")?.value.trim() || "",
            whatsapp: onlyDigits($("iraWhatsapp")?.value || "")
        };
        const obrig = [a.data1, a.hora1, a.data2, a.hora2, a.logradouro, a.numero, a.bairro,
                       a.cep, a.cidade, a.referencia, a.responsavel, a.email, a.whatsapp];
        if (obrig.some(v => !String(v || "").trim())) return { ok: false, message: "Preencha todos os campos do agendamento.", data: a };
        if (a.responsavel.length < 3) return { ok: false, message: "Informe o nome completo do responsável.", data: a };
        const datasValidas = getIraBusinessDatesWithinDays(15).map(formatDateInput);
        if (!datasValidas.includes(a.data1) || !datasValidas.includes(a.data2)) return { ok: false, message: "Selecione datas dentro do período disponível.", data: a };
        const horarios = getIraTimeSlots();
        if (!horarios.includes(a.hora1) || !horarios.includes(a.hora2)) return { ok: false, message: "Selecione horários entre 08h e 18h.", data: a };
        const p1 = getIraDateTimeMinutes(a.data1, a.hora1), p2 = getIraDateTimeMinutes(a.data2, a.hora2);
        if (!Number.isFinite(p1) || !Number.isFinite(p2) || p2 < p1 + 120) return { ok: false, message: "A segunda opção deve ser pelo menos 2 horas após a primeira.", data: a };
        if (!isValidEmail(a.email)) return { ok: false, message: "Informe um e-mail válido.", data: a };
        if (!isValidPhone(a.whatsapp)) return { ok: false, message: "Informe um telefone válido.", data: a };
        return { ok: true, message: "", data: a };
    }

    on("btnConfirmNegotiation", "click", async () => {
        hideText("negotiationError");
        if (!selectedCard) return showText("negotiationError", "Selecione um contrato para negociar.");

        const paymentDate = $("paymentDateInput")?.value || "";
        const paymentMode = $("paymentModeInput")?.value || "vista";
        const installmentCount = Number($("installmentCountInput")?.value || 0);
        const isSecondVia = selectedCard?.tipoPagamentoOperacao === "segunda_via";
        const isParcelado = !isSecondVia && paymentMode === "parcelado" && selectedCard?.permiteParcelamento === true;

        const val = validatePaymentDate(paymentDate);
        if (!val.ok) return showText("negotiationError", val.message);
        if (isParcelado && (!installmentCount || installmentCount < 2)) return showText("negotiationError", "Selecione a quantidade de parcelas.");

        const valorNegociado = isSecondVia
            ? Number(selectedCard?.valorTotal || 0)
            : (isParcelado ? Number(selectedCard?.parcelamento?.valorNegociadoParcelado || 0) : Number(selectedCard?.propostaQuitacao || 0));
        const valorParcela = isParcelado ? getInstallmentAmount(valorNegociado, installmentCount) : valorNegociado;

        setActiveView("vLoading");
        try {
            const data = await callBackend("confirmar_negociacao", {
                documento: currentDoc,
                nomeInformado: $("nameInput")?.value.trim() || "",
                telefoneInformado: onlyDigits($("phoneInput")?.value || ""),
                emailInformado: $("emailInput")?.value.trim() || "",
                credor: selectedCard.credor, idContrato: selectedCard.idContrato,
                numeroContrato: selectedCard.numeroContrato, valorTotal: selectedCard.valorTotal,
                propostaQuitacao: isSecondVia ? selectedCard.valorTotal : selectedCard.propostaQuitacao,
                dataPagamento: paymentDate,
                tipoPagamento: isSecondVia ? "segunda_via" : (isParcelado ? "parcelado" : "avista"),
                quantidadeParcelas: isParcelado ? installmentCount : 1,
                valorNegociado, valorNegociadoFormatado: formatBRL(valorNegociado),
                valorParcela, valorParcelaFormatado: formatBRL(valorParcela),
                parcelamento: selectedCard.parcelamento || {}
            });

            /* CRM não formalizou: tela própria, nunca confirmação de negociação */
            if (data?.proximoStep === "falha_negociacao" || data?.formalizado === false) {
                if (data?.mensagem && $("negotiationFailedMsg")) $("negotiationFailedMsg").textContent = data.mensagem;
                lastHumanChat = selectedCard?.chatUrl || lastHumanChat || chatPadrao();
                return setActiveView("vNegotiationFailed");
            }

            if (data?.proximoStep === "sucesso_negociacao" || data?.status === "ok") {
                const dataFmt = new Date(paymentDate + "T00:00:00").toLocaleDateString("pt-BR");

                if (isSecondVia) {
                    const sub = $("secondCopySub");
                    if (sub) sub.innerHTML = `Seu boleto da <b>${selectedCard.credorNome}</b> está registrado.`;
                    const v = $("secondCopyVenc");
                    if (v) v.innerHTML = `Vencimento em <b>${dataFmt}</b> — <b>${formatBRL(valorNegociado)}</b>`;
                    return setActiveView("vSecondCopySuccess");
                }

                const sub = $("negotiationSuccessSub");
                if (sub) sub.innerHTML = `Seu acordo com a <b>${selectedCard.credorNome}</b> está registrado.`;

                /* Um boleto à vista, um por parcela quando parcelado. E sempre
                   "será enviado" — o envio não é imediato.                     */
                const qtdBoletos = isParcelado ? Math.max(1, installmentCount) : 1;
                const alvo = $("negotiationSuccessBoleto");
                if (alvo) {
                    alvo.innerHTML = qtdBoletos > 1
                        ? `Os <b>${qtdBoletos} boletos</b> serão enviados para o seu e-mail e WhatsApp`
                        : "O boleto será enviado para o seu e-mail e WhatsApp";
                }
                const venc = $("negotiationSuccessVenc");
                if (venc) {
                    venc.innerHTML = (qtdBoletos > 1 ? "Primeiro vencimento em " : "Vencimento em ") +
                        `<b>${dataFmt}</b> — <b>${formatBRL(valorParcela)}</b>`;
                }
                return setActiveView("vNegotiationSuccess");
            }

            telaErro(data?.mensagem);
        } catch (e) {
            telaErro();
        }
    });

    on("btnSubmitIra", "click", async () => {
        hideText("iraError");
        if (!selectedCard) return showText("iraError", "Selecione um contrato para agendamento.");
        const validation = validateIraForm();
        if (!validation.ok) return showText("iraError", validation.message);
        setActiveView("vLoading");
        try {
            const data = await callBackend("confirmar_agendamento_ira", {
                documento: currentDoc,
                nomeInformado: $("nameInput")?.value.trim() || "",
                telefoneInformado: onlyDigits($("phoneInput")?.value || ""),
                emailInformado: $("emailInput")?.value.trim() || "",
                credor: selectedCard.credor, idContrato: selectedCard.idContrato,
                numeroContrato: selectedCard.numeroContrato, agendamento: validation.data
            });
            if (data?.proximoStep === "sucesso_agendamento" || data?.status === "ok") return setActiveView("vIraSuccess");
            telaErro(data?.mensagem);
        } catch (e) {
            telaErro();
        }
    });


    /* ===================== altura para a página que embute ================= */
    /* Quando o portal roda dentro de um iframe, ele mesmo informa a altura do
       conteúdo. Assim a página hospedeira ajusta o quadro e o cliente nunca vê
       barra de rolagem dentro do portal.                                      */
    let ultimaAltura = 0;
    function reportarAltura() {
        if (window.parent === window) return;
        /* Mede o conteúdo real. Usar scrollHeight do documento não funciona:
           ele nunca fica menor que o quadro, então a altura só cresceria.     */
        const portal = document.querySelector(".portal");
        const rodape = document.querySelector(".rodape");
        let h = 0;
        if (portal) {
            const r = portal.getBoundingClientRect();
            h = r.height;
        }
        if (rodape) h = Math.max(h, rodape.getBoundingClientRect().bottom);
        h = Math.ceil(h) + 8;
        if (!h || Math.abs(h - ultimaAltura) < 4) return;
        ultimaAltura = h;
        window.parent.postMessage({ tipo: "portal-altura", altura: h }, "*");
    }
    window.reportarAltura = reportarAltura;
    window.addEventListener("resize", reportarAltura);
    if (typeof ResizeObserver === "function") {
        try { new ResizeObserver(reportarAltura).observe(document.body); } catch (e) {}
    }
    setInterval(reportarAltura, 1200);

    /* ===================== arranque ======================================= */
    setDocType("CPF");
    engineValidacaoFormulario();
    setProgress("vStart");
    if (typeof window.aplicarPortalConfig === "function") window.aplicarPortalConfig();
    reportarAltura();
});
<\/script>
</body>
</html>

</script>

