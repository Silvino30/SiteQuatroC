function escurecer(hex, fator) {
  const s = hex.replace('#', '');
  const c = s.length === 3 ? s.split('').map(x => x + x).join('') : s;
  const n = parseInt(c, 16);
  const r = Math.max(0, Math.round(((n >> 16) & 255) * (1 - fator)));
  const g = Math.max(0, Math.round(((n >> 8) & 255) * (1 - fator)));
  const b = Math.max(0, Math.round((n & 255) * (1 - fator)));
  return '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('').toUpperCase();
}

/* A fonte precisa existir dentro do iframe para a prévia mudar de verdade. */
function carregarFonteNaPrevia(nome) {
  try {
    const doc = $('palco').contentDocument;
    const id = 'fonte-admin';
    let link = doc.getElementById(id);
    if (!link) {
      link = doc.createElement('link');
      link.id = id; link.rel = 'stylesheet';
      doc.head.appendChild(link);
    }
    link.href = 'https://fonts.googleapis.com/css2?family=' +
      encodeURIComponent(nome).replace(/%20/g, '+') + ':wght@400;500;600;700&display=swap';
  } catch (e) {}
}

/* -------------------------------- credores -------------------------------- */
/* Traz configurações gravadas no formato antigo (logosCredor solto e
   integracao.canaisPorCredor) para o formato atual, em que cada credor é um
   bloco único com nome, logo e canais. Rodar duas vezes não muda nada. */
function migrarCredores() {
  if (!CFG) return;
  const mapa = CFG.credores || (CFG.credores = {});

  const logos = CFG.logosCredor || {};
  Object.keys(logos).forEach(k => {
    const c = mapa[k] || (mapa[k] = {});
    if (!c.logo && typeof logos[k] === 'string') c.logo = logos[k];
  });
  delete CFG.logosCredor;

  const canais = (CFG.integracao || {}).canaisPorCredor || {};
  Object.keys(canais).forEach(k => {
    const link = typeof canais[k] === 'string' ? canais[k] : '';
    if (String(k).toUpperCase() === 'PADRAO') {
      CFG.contato = CFG.contato || {};
      if (!CFG.contato.chat && link) CFG.contato.chat = link;
      return;
    }
    const c = mapa[k] || (mapa[k] = {});
    if (!c.chat && link) c.chat = link;
  });
  if (CFG.integracao) delete CFG.integracao.canaisPorCredor;

  /* credor gravado como texto puro era só o endereço do logo */
  Object.keys(mapa).forEach(k => {
    if (typeof mapa[k] === 'string') mapa[k] = { logo: mapa[k] };
    else if (!mapa[k] || typeof mapa[k] !== 'object') mapa[k] = {};
  });
}

