                        telefoneInformado: $("phoneInput")?.value?.trim() || "",
                        emailInformado: $("emailInput")?.value?.trim() || ""
                    });
                    foundRecord = { ...(foundRecord || {}), ...(data || {}) };

                    if (data?.proximoStep === "identidade_incorreta") {
                        identityAttemptCount += 1;
                        return showIdentityError();
                    }
                    if (data?.proximoStep === "sessao_expirada") return telaSessaoExpirada();
                    if (data?.proximoStep === "sem_pendencia") return telaSemPendencia();
                    if (data?.proximoStep === "mostrar_acordo_ativo") return telaAcordoAtivo(data);
                    if (data?.proximoStep === "mostrar_cards") { renderCards(data?.cards || []); return setActiveView("vNext"); }
                    telaErro(data?.mensagem);
