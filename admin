    /* ===================== código de 6 dígitos ============================ */
    const caixasCodigo = [...document.querySelectorAll("#codigoCaixa input")];
    function lerCodigo() { return caixasCodigo.map(c => c.value).join(""); }
    function sincronizaCodigo() {
        const v = lerCodigo();
        if ($("validationCodeInput")) $("validationCodeInput").value = v;
        if ($("btnValidateCode")) $("btnValidateCode").disabled = v.length !== 6;
    }
    function limparCodigo() {
        caixasCodigo.forEach(c => c.value = "");
        $("codigoCaixa")?.classList.remove("erro-cod");
        sincronizaCodigo();
    }
    caixasCodigo.forEach((c, i) => {
        c.addEventListener("input", () => {
            c.value = c.value.replace(/\D/g, "").slice(0, 1);
            $("codigoCaixa")?.classList.remove("erro-cod");
            hideText("validationCodeError");
            if (c.value && caixasCodigo[i + 1]) caixasCodigo[i + 1].focus();
            sincronizaCodigo();
        });
        c.addEventListener("keydown", ev => {
            if (ev.key === "Backspace" && !c.value && caixasCodigo[i - 1]) caixasCodigo[i - 1].focus();
        });
        c.addEventListener("paste", ev => {
            const t = (ev.clipboardData.getData("text") || "").replace(/\D/g, "").slice(0, 6);
            if (!t) return;
            ev.preventDefault();
            t.split("").forEach((d, k) => { if (caixasCodigo[k]) caixasCodigo[k].value = d; });
            caixasCodigo[Math.min(t.length, 5)].focus();
            sincronizaCodigo();
        });
    });

