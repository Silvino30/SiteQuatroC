    /* ===================== detalhes da dívida ============================= */
    /* Mesmo bloco, mesma ordem, em todas as telas que o mostram.             */
    function montarDetalhes(card, alvoId, modo) {
        const dl = $(alvoId || "negotiationDetalhes"); if (!dl) return;
        const ehAcordo = modo === "acordo";
        /* No acordo, as parcelas podem vir em "parcelas" ou em "detalhes". */
        const itens = (ehAcordo && Array.isArray(card.parcelas) && card.parcelas.length)
            ? card.parcelas : (card.detalhes || []);
        const linhas = [];
        linhas.push(`<li><dt>Empresa</dt><dd>${card.credorNome || "-"}</dd></li>`);
        linhas.push(`<li><dt>${ehAcordo ? "Acordo" : "Contrato"}</dt><dd>${card.numeroContrato || "-"}</dd></li>`);

        itens.forEach((d, i) => {
            if (ehAcordo) {
                /* No acordo as linhas são parcelas, não notas em atraso. */
                const situacao = d.pago ? "paga" : ("vence " + (d.vencimentoFormatado || "-"));
                linhas.push(`<li><dt>Parcela ${i + 1}</dt><dd class="livre">${situacao} · ${d.valorFormatado || "-"}</dd></li>`);
                return;
            }
            const rot = d.numero ? `Nota ${d.numero}` : `Nota ${i + 1}`;
            linhas.push(`<li><dt>${rot}</dt><dd class="livre">venceu ${d.vencimentoFormatado || "-"} · ${d.valorFormatado || "-"}</dd></li>`);
        });

        const soma = itens.reduce((a, d) => a + Number(d.valor || 0), 0);
        if (ehAcordo) {
            const total = Number(card.valorNegociado || 0) || soma || Number(card.valorTotal || 0);
            if (total > 0) linhas.push(`<li class="total"><dt>Valor negociado</dt><dd>${formatBRL(total)}</dd></li>`);
            const pago = itens.filter(d => d.pago).reduce((a, d) => a + Number(d.valor || 0), 0);
            if (pago > 0) linhas.push(`<li class="total"><dt>Já pago</dt><dd>${formatBRL(pago)}</dd></li>`);
        } else {
            const original = card.valorOriginal > 0 ? card.valorOriginal : soma;
            if (original > 0) linhas.push(`<li class="total"><dt>Valor original</dt><dd>${formatBRL(original)}</dd></li>`);
            linhas.push(`<li class="total"><dt>Valor atualizado</dt><dd>${card.valorTotalFormatado || formatBRL(card.valorTotal || 0)}</dd></li>`);
            if (card.diasAtraso > 0) linhas.push(`<li><dt>Dias em atraso</dt><dd>${card.diasAtraso}</dd></li>`);
        }
        dl.innerHTML = linhas.join("");
    }

