<script>
/* ===========================================================================
   PAINEL — estado e utilidades
   =========================================================================== */
const SENHA = 'portal2026';

/* Logo da Quatro C usado no login e na navegação. Troque por um arquivo
   hospedado junto com o painel (ex.: 'logo-quatroc.png'); se a imagem não
   carregar, o painel mostra o nome em texto e continua funcionando. */
const LOGO_QUATROC = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTaBEI-qyRmYw_D0waBvLPcxsHtI0AbVj8kX3eyla0WmQ&s=10';

function pintarLogo(alvo, textoFallback) {
  const el = document.getElementById(alvo);
  if (!el) return;
  const img = document.createElement('img');
  img.src = LOGO_QUATROC;
  img.alt = 'Quatro C';
  img.referrerPolicy = 'no-referrer';
  img.onerror = () => { el.innerHTML = '<b>' + textoFallback + '</b>'; };
  el.appendChild(img);
}
pintarLogo('portaLogo', 'Quatro C');
pintarLogo('navLogo', '4C');

document.getElementById('btnOlho').addEventListener('click', () => {
  const i = document.getElementById('senha');
  i.type = i.type === 'password' ? 'text' : 'password';
  i.focus();
});
/* O portal vem embutido nesta própria página: a prévia e o arquivo entregue
   ao cliente saem do mesmo texto, sem depender de nenhum arquivo ao lado. */
const PORTAL_FONTE = lerFontePortal();

/* Telas do portal, na ordem da jornada. Rótulo é o que aparece no seletor. */
const TELAS = [
  ['vStart', '1. Identificação'],
  ['vValidateCode', '2. Código por e-mail'],
  ['vConfirmName', '3. Confirmar identidade'],
  ['vIdentityError', 'Nome não confere'],
  ['vBlocked', 'Acesso restrito'],
  ['vNext', '4. Suas pendências'],
  ['vNegotiate', '5. Pagamento'],
  ['vNegotiationSuccess', '6. Negociação fechada'],
  ['vNegotiationFailed', 'Não concluída'],
  ['vSecondCopySuccess', 'Boleto emitido'],
  ['vActiveAgreement', 'Acordo vigente'],
  ['vReenviado', 'Boleto reenviado'],
  ['vAtendimento', 'Atendimento e especialista'],
  ['vNoRecord', 'Não localizado'],
  ['vNoDebt', 'Em dia'],
  ['vError', 'Indisponível'],
  ['vIraSchedule', 'Agendamento'],
  ['vIraSuccess', 'Agendamento registrado'],
  ['vLoading', 'Carregando']
];
const NOME_TELA = Object.fromEntries(TELAS);

const FONTES = ['Inter','Roboto','Open Sans','Lato','Montserrat','Nunito Sans','Source Sans 3','Work Sans','Poppins','Public Sans'];

let CFG = null;      // configuração em edição
let PADRAO = null;   // configuração original do portal
let MAPA = {};       // mapa de textos que o portal devolveu
let secaoAtual = 'marca';
let filtroTexto = '';
let abertos = {};    // blocos abertos/fechados por tela

const $ = (id) => document.getElementById(id);
const clone = (o) => JSON.parse(JSON.stringify(o));

function avisar(msg, erro) {
  const el = $('aviso');
  el.textContent = msg;
  el.classList.toggle('erro', !!erro);
  el.dataset.ver = '1';
  clearTimeout(el._t);
  el._t = setTimeout(() => { el.dataset.ver = '0'; }, 3200);
}

function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

/* --------------------------------- login ---------------------------------- */
$('btnEntrar').addEventListener('click', entrar);
$('senha').addEventListener('keydown', e => { if (e.key === 'Enter') entrar(); });
function entrar() {
  if ($('senha').value !== SENHA) {
    $('senhaErro').classList.remove('hidden');
    return;
  }
  $('porta').classList.add('hidden');
  $('app').classList.remove('hidden');
  montarSeletorTelas();
  $('palco').srcdoc = PORTAL_FONTE;   // só monta a prévia depois de entrar
}

/* ===========================================================================
   Conversa com o portal (iframe)
   =========================================================================== */
const palco = () => $('palco').contentWindow;

window.addEventListener('message', (ev) => {
  if (!ev.data) return;

  if (ev.data.tipo === 'portal-pronto') {
    /* pega a configuração de fábrica direto do portal e pede o mapa de textos */
    try {
      PADRAO = clone($('palco').contentWindow.PORTAL_CONFIG || {});
    } catch (e) { PADRAO = {}; }
    if (!CFG) CFG = clone(PADRAO);
    palco().postMessage({ tipo: 'portal-pedir-mapa' }, '*');
    return;
  }

  if (ev.data.tipo === 'portal-mapa') {
    MAPA = ev.data.mapa || {};
    render();
    aplicar();
    return;
  }
});

function aplicar() {
  if (!CFG) return;
  try { palco().postMessage({ tipo: 'portal-config', config: clone(CFG) }, '*'); } catch (e) {}
}

function verTela(tela) {
  try { palco().postMessage({ tipo: 'portal-ver-tela', tela: tela }, '*'); } catch (e) {}
}

function montarSeletorTelas() {
  const sel = $('seletorTela');
  sel.innerHTML = TELAS.map(([id, nome]) => `<option value="${id}">${nome}</option>`).join('');
  sel.addEventListener('change', () => verTela(sel.value));
}

/* ===========================================================================
   Navegação
   =========================================================================== */
document.querySelectorAll('.nav-item').forEach(b => {
  b.addEventListener('click', () => {
    secaoAtual = b.dataset.secao;
    document.querySelectorAll('.nav-item').forEach(o =>
      o.setAttribute('aria-current', String(o === b)));
    render();
  });
});

/* ===========================================================================
   Render das seções
   =========================================================================== */
