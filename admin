/* --------------------------------- textos --------------------------------- */
function renderTextos(alvo) {
  CFG.textos = CFG.textos || {};
  const chaves = Object.keys(MAPA);

  if (!chaves.length) {
    alvo.innerHTML = '<div class="bloco"><p class="vazio">Aguardando o portal responder o mapa de textos…</p></div>';
    return;
  }

  /* agrupa por tela, na ordem da jornada */
  const grupos = {};
  chaves.forEach(k => {
    const tela = MAPA[k].tela || 'global';
    (grupos[tela] = grupos[tela] || []).push(k);
  });
  const ordem = TELAS.map(t => t[0]).filter(t => grupos[t]);
  if (grupos.global) ordem.unshift('global');

  const filtro = filtroTexto.trim().toLowerCase();
  const combina = (k) => !filtro
    || k.toLowerCase().includes(filtro)
    || String(valorAtual(k)).toLowerCase().includes(filtro)
    || String(MAPA[k].padrao || '').toLowerCase().includes(filtro);

  let html = `
    <div class="busca">
      <svg fill="none" height="15" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" viewBox="0 0 24 24" width="15"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4.3-4.3"></path></svg>
      <input id="buscaTxt" placeholder="Buscar por texto ou chave..." type="text" value="${esc(filtroTexto)}"/>
    </div>`;

  let achou = 0;
  ordem.forEach(tela => {
    const itens = grupos[tela].filter(combina).sort();
    if (!itens.length) return;
    achou += itens.length;
    const fechado = abertos[tela] === false ? ' fechado' : '';
    html += `
      <div class="bloco${fechado}" data-tela="${tela}">
        <div class="bloco-cabeca" role="button" data-toggle="${tela}">
          <svg class="giro" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" viewBox="0 0 24 24" width="14"><path d="M6 9l6 6 6-6"></path></svg>
          <h3>${tela === 'global' ? 'Cabeçalho e botões gerais' : (NOME_TELA[tela] || tela)}</h3>
          <span class="cont">${itens.length}</span>
        </div>
        <div class="bloco-corpo">
          ${itens.map(k => itemTexto(k)).join('')}
        </div>
      </div>`;
  });

  if (!achou) html += '<div class="bloco"><p class="vazio">Nenhum texto encontrado para essa busca.</p></div>';
  alvo.innerHTML = html;

  const busca = $('buscaTxt');
  busca.addEventListener('input', e => {
    filtroTexto = e.target.value;
    const pos = e.target.selectionStart;
    renderTextos(alvo);
    const novo = $('buscaTxt');
    novo.focus(); novo.setSelectionRange(pos, pos);
  });

  alvo.querySelectorAll('[data-toggle]').forEach(h => {
    h.addEventListener('click', () => {
      const tela = h.dataset.toggle;
      abertos[tela] = abertos[tela] === false ? true : false;
      h.closest('.bloco').classList.toggle('fechado');
    });
  });

  alvo.querySelectorAll('textarea[data-chave]').forEach(ta => {
    ta.addEventListener('input', () => {
      const k = ta.dataset.chave;
      CFG.textos[k] = ta.value;
      ta.closest('.txt-item').classList.toggle('alterado', ta.value !== MAPA[k].padrao);
      const reset = ta.closest('.txt-item').querySelector('.txt-reset');
      if (reset) reset.disabled = ta.value === MAPA[k].padrao;
      aplicar();
    });
  });

  alvo.querySelectorAll('.txt-reset[data-reset]').forEach(b => {
    b.addEventListener('click', () => {
      const k = b.dataset.reset;
      CFG.textos[k] = MAPA[k].padrao;
      const ta = alvo.querySelector(`textarea[data-chave="${k}"]`);
      if (ta) ta.value = MAPA[k].padrao;
      b.closest('.txt-item').classList.remove('alterado');
      b.disabled = true;
      aplicar();
    });
  });
}

function valorAtual(k) {
  const v = (CFG.textos || {})[k];
  return v === undefined ? (MAPA[k].padrao || '') : v;
}

function itemTexto(k) {
  const info = MAPA[k];
  const valor = valorAtual(k);
  const alterado = valor !== info.padrao;
  const tipo = info.tipo === 'botao' ? 'botao' : (info.tipo === 'titulo' ? 'titulo' : 'texto');
  const rotuloTipo = { botao: 'botão', titulo: 'título', texto: 'texto', rotulo: 'rótulo' }[info.tipo] || 'texto';
  return `
    <div class="txt-item${alterado ? ' alterado' : ''}">
      <div class="txt-topo">
        <span class="selo ${tipo}">${rotuloTipo}</span>
        <span class="txt-chave">${esc(k)}</span>
        <button class="txt-reset" data-reset="${esc(k)}" type="button"${alterado ? '' : ' disabled'}>voltar ao padrão</button>
      </div>
      <textarea data-chave="${esc(k)}" rows="${valor.length > 90 ? 3 : 1}">${esc(valor)}</textarea>
    </div>`;
}

/* ------------------------------- integração ------------------------------- */
function renderIntegracao(alvo) {
  const i = CFG.integracao || (CFG.integracao = {});
  alvo.innerHTML = `
    <div class="bloco">
      <div class="bloco-cabeca"><h3>Backend</h3></div>
      <div class="bloco-corpo">
        <div class="campo">
          <label for="inEndpoint">Endereço do worker</label>
          <input id="inEndpoint" type="text" value="${esc(i.endpoint || '')}"/>
          <p class="ajuda">Todas as etapas do portal chamam este endereço. Só altere junto com o time técnico.</p>
        </div>
      </div>
    </div>`;

  $('inEndpoint').addEventListener('input', e => { CFG.integracao.endpoint = e.target.value.trim(); aplicar(); });
}

/* ===========================================================================
   Imagem, arquivos e publicação
   =========================================================================== */
let aoEscolherImagem = null;
function pedirImagem(cb) { aoEscolherImagem = cb; $('inputLogo').click(); }
$('inputLogo').addEventListener('change', (ev) => {
  const f = ev.target.files && ev.target.files[0];
  ev.target.value = '';
  if (!f || !aoEscolherImagem) return;
  if (f.size > 400 * 1024) return avisar('Imagem muito grande. Use um arquivo de até 400 KB.', true);
  const fr = new FileReader();
  fr.onload = () => { aoEscolherImagem(fr.result); aoEscolherImagem = null; };
  fr.readAsDataURL(f);
});

function baixar(nome, conteudo, tipo) {
  const blob = new Blob([conteudo], { type: tipo });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = nome;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1500);
}

function nomeArquivo() {
  const n = ((CFG.marca || {}).nome || 'portal').toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return n || 'portal';
}

$('btnSalvarCfg').addEventListener('click', () => {
  baixar('config-' + nomeArquivo() + '.json', JSON.stringify(CFG, null, 2), 'application/json');
  avisar('Configuração salva.');
});

$('btnCarregarCfg').addEventListener('click', () => $('inputCfg').click());
$('inputCfg').addEventListener('change', (ev) => {
  const f = ev.target.files && ev.target.files[0];
  ev.target.value = '';
  if (!f) return;
  const fr = new FileReader();
  fr.onload = () => {
    try {
      CFG = JSON.parse(fr.result);
      render(); aplicar();
      if (CFG.marca && CFG.marca.fonte) carregarFonteNaPrevia(CFG.marca.fonte);
      avisar('Configuração carregada.');
    } catch (e) { avisar('Arquivo inválido.', true); }
  };
  fr.readAsText(f);
});

$('btnRestaurar').addEventListener('click', () => {
  if (!PADRAO) return;
  CFG = clone(PADRAO);
  render(); aplicar();
  avisar('Configuração restaurada para o padrão.');
});

/* Baixar aplicação: lê o portal, troca o bloco de configuração e entrega um
   arquivo único, pronto para o cliente publicar. */
$('btnBaixarApp').addEventListener('click', () => {
  try {
    const bloco = '<script id="portal-config">\nwindow.PORTAL_CONFIG = ' +
      JSON.stringify(CFG, null, 2) + ';\n<' + '/script>';

    const re = /<script id="portal-config">[\s\S]*?<\/script>/;
    if (!re.test(PORTAL_FONTE)) throw new Error('bloco-nao-encontrado');

    const saida = PORTAL_FONTE.replace(re, bloco);
    baixar('autoatendimento-' + nomeArquivo() + '.html', saida, 'text/html;charset=utf-8');
    avisar('Aplicação gerada. Um arquivo único, pronto para publicar.');
  } catch (e) {
    avisar('Não consegui gerar o arquivo. Recarregue a página e tente de novo.', true);
  }
});
</script>
