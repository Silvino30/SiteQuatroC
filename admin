            const connectorTerms = new Set(["DE", "DA", "DO", "DAS", "DOS", "E"]);
            const words = clean.replace(legalTerms, "").split(/\s+/)
                .map(w => w.replace(/[^\p{L}]/gu, "")).filter(w => w && !connectorTerms.has(w));
            const base = `${words[0] || "EMPRESA"} ${words[1] || "BRASIL"}`.trim();
            const lib = ["CONSULTORIA","SERVICOS","COMERCIO","SOLUCOES EMPRESARIAIS","GESTAO E NEGOCIOS",
                         "TECNOLOGIA","ASSESSORIA","REPRESENTACOES","TRANSPORTES","EMPREENDIMENTOS",
                         "PARTICIPACOES","LOGISTICA","COMERCIAL","ADMINISTRADORA","NEGOCIOS DIGITAIS"]
                        .map(s => `${base} ${s}`);
            return uniqueOptions([clean || `${base} SERVICOS`, ...shuffleArray(lib)]).slice(0, 4);
        }

        const parts = clean.split(/\s+/).filter(Boolean);
        const prefix = `${parts[0] || "MARIA"} ${parts[1] || "HELENA"}`.trim();
        const lib = ["LIMA","ALMEIDA","MARTINS","SOUZA","COSTA","PEREIRA","SANTOS","OLIVEIRA","RIBEIRO","FERREIRA"]
                    .map(s => `${prefix} ${s}`);
        return uniqueOptions([clean || `${prefix} COSTA`, ...shuffleArray(lib)]).slice(0, 4);
    }

    function prepareIdentityOptions(options, fullName, typeUpper) {
        const type = String(typeUpper || "").toUpperCase() === "CNPJ" ? "CNPJ" : "CPF";
        const real = String(fullName || "").replace(/\s+/g, " ").trim().toUpperCase();
        let finalOptions = uniqueOptions([real, ...buildFallbackNameOptions(real, type)]).filter(Boolean);
        while (finalOptions.length < 4) {
            finalOptions = uniqueOptions([...finalOptions, ...buildFallbackNameOptions(finalOptions[0] || real, type)]);
        }
        return shuffleArray(finalOptions.slice(0, 4));
    }

    function showIdentityError() {
        if (identityAttemptCount >= 3) return setActiveView("vBlocked");
        const msg = $("identityAttemptMsg");
        if (msg) {
