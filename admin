  const lista = $('listaCredores');
  chaves.forEach(chave => {
    const c = mapa[chave];
    const card = document.createElement('div');
    card.className = 'credor-card';
    card.innerHTML = `
      <div class="credor-topo">
        <div class="logo-previa">${c.logo ? `<img src="${esc(c.logo)}" alt=""/>` : '<span>sem logo</span>'}</div>
        <span class="credor-nome">${esc(c.nome || chave)}</span>
        <button class="lixeira" title="Remover credor" type="button">${SVG_LIXEIRA}</button>
      </div>
      <div class="credor-grade">
        <div class="campo">
          <label>Nome no CRM</label>
          <input data-f="chave" type="text" value="${esc(chave)}"/>
          <p class="ajuda">Exatamente como o CRM devolve.</p>
        </div>
        <div class="campo">
          <label>Nome exibido no portal</label>
          <input data-f="nome" placeholder="${esc(chave)}" type="text" value="${esc(c.nome || '')}"/>
          <p class="ajuda">É este nome que o cliente lê. Em branco, aparece o do CRM.</p>
        </div>
        <div class="campo">
          <label>WhatsApp</label>
          <input data-f="whatsapp" placeholder="${esc(g.whatsapp || 'usa o canal geral')}" type="text" value="${esc(c.whatsapp || '')}"/>
          <p class="ajuda">Link wa.me. Em branco, usa o WhatsApp geral.</p>
        </div>
        <div class="campo">
          <label>Telefone</label>
          <input data-f="telefone" placeholder="${esc(g.telefone || 'usa o canal geral')}" type="text" value="${esc(c.telefone || '')}"/>
          <p class="ajuda">Em branco, usa o telefone geral.</p>
        </div>
        <div class="campo larga">
          <label>Link do chat</label>
          <input data-f="chat" placeholder="${esc(g.chat || 'usa o chat geral')}" type="text" value="${esc(c.chat || '')}"/>
          <p class="ajuda">Entra como <b>Chat online</b> ao lado do WhatsApp e do telefone, nas telas de atendimento deste credor. Em branco, usa o chat geral.</p>
        </div>
      </div>`;

    /* nome, canais e chat: gravam a cada tecla, sem redesenhar a seção */
    card.querySelectorAll('input[data-f]').forEach(inp => {
      const campo = inp.dataset.f;
      if (campo === 'chave') return;
      inp.addEventListener('input', e => {
        const v = e.target.value.trim();
        if (v) c[campo] = v; else delete c[campo];
        if (campo === 'nome') card.querySelector('.credor-nome').textContent = v || chave;
        aplicar();
      });
    });

    /* renomear a chave preservando tudo que já está preenchido */
    card.querySelector('input[data-f="chave"]').addEventListener('change', e => {
      const nova = e.target.value.trim().toUpperCase();
      if (!nova || nova === chave) return;
      if (mapa[nova] !== undefined) { e.target.value = chave; return avisar('Já existe um credor com esse nome no CRM.', true); }
      const bloco = mapa[chave];
      delete mapa[chave];
      mapa[nova] = bloco;
      render(); aplicar();
    });

    const previa = card.querySelector('.logo-previa');
    previa.style.cursor = 'pointer';
    previa.title = 'Clique para enviar uma imagem';
    previa.addEventListener('click', () => pedirImagem(dataUrl => {
      c.logo = dataUrl;
      render(); aplicar();
      avisar('Logo de ' + (c.nome || chave) + ' atualizado.');
    }));

    card.querySelector('.lixeira').addEventListener('click', () => {
      delete mapa[chave];
      render(); aplicar();
    });

    lista.appendChild(card);
  });

  $('btnAddCredor').addEventListener('click', () => {
    const nome = $('novoCredor').value.trim().toUpperCase();
    if (!nome) return avisar('Informe o nome do credor.', true);
    if (mapa[nome] !== undefined) return avisar('Este credor já está cadastrado.', true);
    mapa[nome] = {};
    render(); aplicar();
    avisar('Credor adicionado. Preencha o nome exibido e os canais.');
  });
}

