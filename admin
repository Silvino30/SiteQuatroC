  if (!CFG) return;
  migrarCredores();
  const box = $('edicao');
  const cabeca = {
    marca:      ['Marca', 'Logo, cores e fonte do portal. A cor primária controla o botão de ação, a barra de progresso, os links e a seleção.'],
    credores:   ['Credores', 'Um cadastro por credor: como o nome chega do CRM, como ele aparece para o cliente, o logo e os canais de atendimento daquele projeto. Campo em branco herda o canal geral.'],
    canais:     ['Canais gerais e rodapé', 'Usados quando o credor não tem canal próprio, e nas telas em que ainda não há credor definido (identificação, erro, sem pendência).'],
    textos:     ['Textos e botões', 'Todo texto editável do portal, agrupado pela tela onde aparece. A estrutura das telas é fixa.'],
    integracao: ['Integração', 'Endereço do backend. Mexa aqui só com o time técnico.']
  }[secaoAtual];

  box.innerHTML =
    `<div class="edicao-topo">
       <div><h2>${cabeca[0]}</h2><p>${cabeca[1]}</p></div>
       <button class="btn-previa" type="button" onclick="document.getElementById('previa').classList.add('aberta')">Ver prévia</button>
     </div>
     <div id="secao"></div>`;

  const alvo = $('secao');
  if (secaoAtual === 'marca') renderMarca(alvo);
  if (secaoAtual === 'credores') renderCredores(alvo);
  if (secaoAtual === 'canais') renderCanais(alvo);
  if (secaoAtual === 'textos') renderTextos(alvo);
  if (secaoAtual === 'integracao') renderIntegracao(alvo);
}

