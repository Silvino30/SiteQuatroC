<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Quatro C | Administração Autoatendimento</title>
<meta content="#CE2E3C" name="theme-color"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet"/>
<style>
/* ===========================================================================
   PAINEL DE ADMINISTRAÇÃO
   Três áreas: navegação (esquerda), edição (centro), pré-visualização (direita).
   O painel não conhece as telas: ele pergunta ao portal quais textos existem
   e se monta a partir da resposta. Tela nova no portal aparece aqui sozinha.
   =========================================================================== */
:root{
  --tinta:#15151B; --tinta-2:#5C5C6A; --tinta-3:#8A8A98;
  --linha:#E6E6EC; --linha-2:#D5D5DE;
  --papel:#fff; --fundo:#F5F5F8;
  --escuro:#1D1D24; --escuro-2:#26262F;
  /* identidade Quatro C */
  --acento:#CE2E3C; --acento-escuro:#A3222E; --acento-fraco:#FBECEE;
  --ouro:#EB9B3C; --verde:#2C8A61;
  --ok:#0A7346; --alerta:#8A5D0C; --falha:#B02A22;
  --r:8px; --r-p:6px;
}
*{box-sizing:border-box}
body{
  margin:0;font-family:'Roboto',Arial,sans-serif;
  background:var(--fundo);color:var(--tinta);font-size:14px;line-height:1.5;
  letter-spacing:-.005em;-webkit-font-smoothing:antialiased;
}
button{font:inherit;cursor:pointer;color:inherit}
input,select,textarea{font:inherit}
svg{display:block;flex:0 0 auto}
.hidden{display:none !important}

/* --------------------------- faixa da marca ------------------------------- */
.topbar{
  height:5px;
  background:linear-gradient(90deg,var(--acento) 0 70%,var(--ouro) 70% 86%,var(--verde) 86% 100%);
}

/* ------------------------------- porta ------------------------------------ */
.porta{
  min-height:100vh;display:grid;place-items:center;padding:32px 24px;
  background:
    radial-gradient(circle at top left, rgba(206,46,60,.07), transparent 36%),
    linear-gradient(180deg,#FFFFFF 0%,#FCFCFD 44%,#F5F5F8 100%);
}
.porta-caixa{
  width:100%;max-width:404px;background:var(--papel);border:1px solid var(--linha);
  border-radius:22px;padding:38px 34px 32px;box-shadow:0 28px 66px rgba(36,36,40,.12);
}
.porta-logo{display:flex;justify-content:center;margin-bottom:22px}
.porta-logo img{height:64px;width:auto;max-width:190px;object-fit:contain}
.porta-logo b{font-size:22px;font-weight:900;color:var(--acento);letter-spacing:-.02em}
.porta-selo{
  display:inline-flex;align-items:center;gap:7px;margin:0 auto 16px;padding:7px 13px;
  border-radius:999px;background:var(--acento-fraco);border:1px solid rgba(206,46,60,.14);
  color:var(--acento);font-size:10.5px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;
}
.porta-caixa h1{margin:0 0 7px;font-size:22px;font-weight:700;letter-spacing:-.028em;color:#303038}
.porta-caixa p.porta-apoio{margin:0 0 26px;font-size:13.5px;line-height:1.6;color:#71717A}
.porta-centro{display:flex;flex-direction:column;align-items:center;text-align:center}
.porta-form{width:100%;text-align:left}
.porta-senha{position:relative;display:flex;align-items:center}
.porta-senha > svg{position:absolute;left:13px;color:var(--tinta-3);pointer-events:none}
.porta-senha input{
  width:100%;padding:12px 44px 12px 40px;border:1px solid var(--linha-2);border-radius:10px;
  font-size:14.5px;color:var(--tinta);background:var(--papel);
}
.porta-senha input:focus{outline:none;border-color:var(--acento);box-shadow:0 0 0 3px rgba(206,46,60,.12)}
.porta-olho{
  position:absolute;right:6px;width:32px;height:32px;display:grid;place-items:center;
  background:none;border:0;border-radius:8px;color:var(--tinta-3);
}
.porta-olho:hover{color:var(--acento);background:var(--acento-fraco)}
.porta-caixa .btn-1{margin-top:18px;min-height:46px;font-size:14px;border-radius:10px}
.porta-nota{
  margin:22px 0 0;padding-top:18px;border-top:1px solid var(--linha);
  display:flex;align-items:flex-start;gap:9px;font-size:11.5px;line-height:1.55;color:var(--tinta-3);
}
.porta-nota svg{flex:0 0 auto;margin-top:1px;color:var(--verde)}
.porta-rodape{margin:20px 0 0;text-align:center;font-size:11px;color:#9A9AA6}

/* ------------------------------- estrutura -------------------------------- */
.app{display:grid;grid-template-columns:206px minmax(360px,1fr) minmax(420px,600px);height:100vh}
@media (max-width:1180px){
  .app{grid-template-columns:186px 1fr;height:auto}
  .previa{display:none}
  .previa.aberta{display:flex;position:fixed;inset:0;z-index:80;background:var(--papel)}
}

/* nav */
.nav{background:var(--escuro);color:#fff;padding:18px 14px;overflow-y:auto;display:flex;flex-direction:column}
.nav-marca{display:flex;align-items:center;gap:9px;padding:0 6px 18px;border-bottom:1px solid rgba(255,255,255,.1);margin-bottom:14px}
.nav-logo{flex:0 0 auto;display:grid;place-items:center;height:38px;width:52px}
.nav-logo img{max-height:38px;max-width:52px;object-fit:contain}
.nav-logo b{font-size:12px;font-weight:900;color:#fff;letter-spacing:-.01em}
.nav-marca b{font-size:13px;font-weight:700;letter-spacing:-.01em}
.nav-marca span{display:block;font-size:10px;color:rgba(255,255,255,.45);font-weight:500}
.nav-item{
  width:100%;display:flex;align-items:center;gap:10px;padding:9px 10px;margin-bottom:2px;
  background:none;border:0;border-radius:var(--r-p);text-align:left;
  font-size:13px;font-weight:500;color:rgba(255,255,255,.7);
}
.nav-item:hover{background:rgba(255,255,255,.07);color:#fff}
.nav-item[aria-current="true"]{background:rgba(255,255,255,.13);color:#fff;font-weight:600}
.nav-rodape{margin-top:auto;padding-top:16px;border-top:1px solid rgba(255,255,255,.1);display:grid;gap:6px}
.nav-rodape button{
  width:100%;padding:9px 10px;border-radius:var(--r-p);border:1px solid rgba(255,255,255,.18);
  background:none;color:rgba(255,255,255,.8);font-size:12px;font-weight:600;text-align:left;
  display:flex;align-items:center;gap:8px;
}
.nav-rodape button:hover{background:rgba(255,255,255,.08);color:#fff}
.nav-rodape button.destaque{background:#fff;color:var(--escuro);border-color:#fff}
.nav-rodape button.destaque:hover{background:rgba(255,255,255,.88)}

/* edição */
.edicao{overflow-y:auto;padding:26px 28px 60px;background:var(--fundo)}
.edicao-topo{display:flex;align-items:flex-start;gap:16px;margin-bottom:22px}
.edicao-topo h2{margin:0 0 3px;font-size:19px;letter-spacing:-.024em}
.edicao-topo p{margin:0;font-size:13px;color:var(--tinta-3);max-width:52ch}
.btn-previa{
  margin-left:auto;flex:0 0 auto;padding:8px 12px;border-radius:var(--r-p);
  border:1px solid var(--linha-2);background:var(--papel);font-size:12.5px;font-weight:600;
}
@media (min-width:1181px){.btn-previa{display:none}}

.bloco{background:var(--papel);border:1px solid var(--linha);border-radius:12px;margin-bottom:16px;overflow:hidden}
.bloco-cabeca{padding:14px 18px;border-bottom:1px solid var(--linha);display:flex;align-items:center;gap:10px}
.bloco-cabeca h3{margin:0;font-size:13.5px;font-weight:600}
.bloco-cabeca .cont{margin-left:auto;font-size:11.5px;color:var(--tinta-3);font-weight:500}
.bloco-corpo{padding:18px}
.bloco.fechado .bloco-corpo{display:none}
.bloco-cabeca[role="button"]{cursor:pointer}
.bloco-cabeca .giro{transition:transform .2s;color:var(--tinta-3)}
.bloco.fechado .bloco-cabeca .giro{transform:rotate(-90deg)}

.campo{margin-bottom:14px}
.campo:last-child{margin-bottom:0}
.campo label{display:block;margin-bottom:5px;font-size:12.5px;font-weight:600;color:var(--tinta-2)}
.campo .ajuda{margin:4px 0 0;font-size:11.5px;color:var(--tinta-3)}
.campo input[type=text],.campo input[type=url],.campo select,.campo textarea{
  width:100%;padding:9px 11px;border:1px solid var(--linha-2);border-radius:var(--r-p);
  font-size:13.5px;color:var(--tinta);background:var(--papel);
}
.campo textarea{resize:vertical;min-height:60px;line-height:1.45}
.campo input:focus,.campo select:focus,.campo textarea:focus{
  outline:none;border-color:var(--acento);box-shadow:0 0 0 3px rgba(206,46,60,.12);
}
.grade2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:620px){.grade2{grid-template-columns:1fr}}

/* cor */
.cor{display:flex;align-items:center;gap:10px}
.cor input[type=color]{
  width:42px;height:38px;padding:0;border:1px solid var(--linha-2);border-radius:var(--r-p);
  background:none;cursor:pointer;
}
.cor input[type=text]{flex:1;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px}

/* logo */
.logo-area{display:flex;align-items:center;gap:14px}
.logo-previa{
  width:112px;height:52px;flex:0 0 112px;border:1px dashed var(--linha-2);border-radius:var(--r-p);
  display:grid;place-items:center;background:#FAFAFC;overflow:hidden;
}
.logo-previa img{max-width:100%;max-height:100%;object-fit:contain}
.logo-previa span{font-size:10.5px;color:var(--tinta-3);text-align:center;padding:0 6px}
.logo-acoes{display:grid;gap:6px}

/* credores */
.credor-card{border:1px solid var(--linha-2);border-radius:var(--r);padding:12px 14px 4px;margin-bottom:12px}
.credor-card:last-of-type{margin-bottom:0}
.credor-topo{display:flex;align-items:center;gap:12px;padding-bottom:10px;border-bottom:1px solid var(--linha)}
.credor-topo .logo-previa{width:76px;height:38px;flex:0 0 76px}
.credor-nome{flex:1;min-width:0;font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.credor-grade{display:grid;grid-template-columns:1fr 1fr;gap:0 14px;padding-top:12px}
.credor-grade .larga{grid-column:1/-1}
@media (max-width:700px){.credor-grade{grid-template-columns:1fr}}
.lixeira{
  width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--linha-2);
  border-radius:var(--r-p);background:var(--papel);color:var(--tinta-3);
}
.lixeira:hover{border-color:var(--falha);color:var(--falha)}

/* textos */
.busca{position:relative;margin-bottom:14px}
.busca svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--tinta-3)}
.busca input{width:100%;padding:9px 11px 9px 34px;border:1px solid var(--linha-2);border-radius:var(--r-p);font-size:13.5px}
.busca input:focus{outline:none;border-color:var(--acento);box-shadow:0 0 0 3px rgba(206,46,60,.12)}

.txt-item{padding:12px 0;border-bottom:1px solid var(--linha)}
.txt-item:last-child{border-bottom:0}
.txt-topo{display:flex;align-items:center;gap:8px;margin-bottom:5px}
.txt-chave{font-size:11px;color:var(--tinta-3);font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.selo{
  padding:1px 6px;border-radius:4px;font-size:10px;font-weight:700;letter-spacing:.03em;
  text-transform:uppercase;background:#F1F1F6;color:var(--tinta-2);
}
.selo.botao{background:var(--acento-fraco);color:var(--acento)}
.selo.titulo{background:#F3EEFB;color:#6B3FA0}
.txt-reset{margin-left:auto;background:none;border:0;padding:2px 4px;font-size:11.5px;font-weight:600;color:var(--acento)}
.txt-reset:hover{text-decoration:underline}
.txt-reset[disabled]{color:var(--tinta-3);cursor:default;text-decoration:none}
.txt-item textarea{
  width:100%;padding:8px 10px;border:1px solid var(--linha-2);border-radius:var(--r-p);
  font-size:13.5px;resize:vertical;min-height:38px;line-height:1.45;
}
.txt-item textarea:focus{outline:none;border-color:var(--acento);box-shadow:0 0 0 3px rgba(206,46,60,.12)}
.txt-item.alterado textarea{border-color:var(--acento)}

.vazio{padding:26px;text-align:center;font-size:13px;color:var(--tinta-3)}

/* prévia */
.previa{background:var(--papel);border-left:1px solid var(--linha);display:flex;flex-direction:column}
.previa-topo{padding:12px 16px;border-bottom:1px solid var(--linha);display:flex;align-items:center;gap:10px}
.previa-topo b{font-size:12.5px;font-weight:600}
.previa-topo select{
  margin-left:auto;padding:7px 10px;border:1px solid var(--linha-2);border-radius:var(--r-p);
  font-size:12.5px;max-width:230px;background:var(--papel);
}
.previa-fechar{background:none;border:0;color:var(--tinta-3);padding:4px}
@media (min-width:1181px){.previa-fechar{display:none}}
.previa-palco{flex:1;background:var(--fundo);padding:16px;overflow:auto;display:flex;justify-content:center}
.previa-palco iframe{
  width:100%;max-width:420px;height:100%;min-height:640px;border:1px solid var(--linha);
  border-radius:12px;background:#fff;box-shadow:0 8px 30px rgba(16,16,26,.07);
}

/* aviso */
.aviso{
  position:fixed;left:50%;bottom:22px;transform:translate(-50%,240%);z-index:200;
  padding:11px 18px;border-radius:10px;background:var(--escuro);color:#fff;
  font-size:13px;font-weight:500;box-shadow:0 12px 34px rgba(0,0,0,.25);
  transition:transform .28s cubic-bezier(.4,0,.2,1), visibility .28s;max-width:88vw;
  visibility:hidden;
}
.aviso[data-ver="1"]{transform:translate(-50%,0);visibility:visible}
.aviso.erro{background:var(--falha)}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:var(--r-p);border:0;transition:.14s}
.btn-1{padding:10px 16px;background:var(--acento);color:#fff;font-size:13.5px;font-weight:600;width:100%}
.btn-1:hover{background:var(--acento-escuro)}
.btn-2{padding:8px 13px;background:var(--papel);border:1px solid var(--linha-2);font-size:12.5px;font-weight:600;color:var(--tinta-2)}
.btn-2:hover{border-color:var(--tinta-3);color:var(--tinta)}
</style>
