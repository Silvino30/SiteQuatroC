    /* ===================== agendamento IRA ================================ */
    function getIraBusinessDatesWithinDays(days = 15) {
        const dates = []; const today = new Date(); today.setHours(0, 0, 0, 0);
        const cursor = new Date(today); cursor.setDate(cursor.getDate() + 1);
        const limit = new Date(today); limit.setDate(limit.getDate() + days); limit.setHours(0, 0, 0, 0);
        while (cursor <= limit) {
            if (cursor.getDay() !== 0 && cursor.getDay() !== 6) dates.push(new Date(cursor));
            cursor.setDate(cursor.getDate() + 1);
        }
        return dates;
    }
    function getIraTimeSlots() { return ["08:00", "10:00", "12:00", "14:00", "16:00", "18:00"]; }

    function setupIraDateOptions() {
        const dates = getIraBusinessDatesWithinDays(15);
        const options = '<option value="">Selecione a data</option>' + dates.map(dt =>
            `<option value="${formatDateInput(dt)}">${dt.toLocaleDateString("pt-BR", { weekday: "long", day: "2-digit", month: "2-digit" })}</option>`).join("");
        [$("iraDate1"), $("iraDate2")].forEach(el => { if (el) { el.innerHTML = options; el.value = ""; } });
        updateIraSecondOptionConstraints();
    }
    function setupIraTimeOptions() {
        const options = ['<option value="">Selecione o horário</option>']
            .concat(getIraTimeSlots().map(v => `<option value="${v}">${v}</option>`)).join("");
        [$("iraTime1"), $("iraTime2")].forEach(el => { if (el) { el.innerHTML = options; el.value = ""; } });
        updateIraSecondOptionConstraints();
    }
    function iraTimeToMinutes(value) {
        const p = String(value || "").split(":"); if (p.length < 2) return NaN;
        const hh = Number(p[0]), mm = Number(p[1]);
        if (!Number.isFinite(hh) || !Number.isFinite(mm)) return NaN;
        return hh * 60 + mm;
    }
    function getIraDateTimeMinutes(dateValue, timeValue) {
        if (!dateValue || !timeValue) return NaN;
        const dt = new Date(String(dateValue) + "T00:00:00");
        if (Number.isNaN(dt.getTime())) return NaN;
        return dt.getTime() / 60000 + iraTimeToMinutes(timeValue);
    }
    function updateIraSecondOptionConstraints() {
        const date1 = $("iraDate1"), time1 = $("iraTime1"), date2 = $("iraDate2"), time2 = $("iraTime2");
        if (!date1 || !time1 || !date2 || !time2) return;
        const first = getIraDateTimeMinutes(date1.value, time1.value);
        const minSecond = Number.isFinite(first) ? first + 120 : NaN;
        Array.from(date2.options).forEach(o => {
            if (!o.value || !Number.isFinite(minSecond)) { o.disabled = false; return; }
            o.disabled = !getIraTimeSlots().some(slot => {
                const c = getIraDateTimeMinutes(o.value, slot);
                return Number.isFinite(c) && c >= minSecond;
            });
        });
        if (date2.value) {
            const sel = Array.from(date2.options).find(o => o.value === date2.value);
            if (sel?.disabled) { date2.value = ""; time2.value = ""; }
        }
        const prev = time2.value;
        time2.innerHTML = ['<option value="">Selecione o horário</option>'].concat(
            getIraTimeSlots().map(slot => {
                let disabled = false;
                if (date2.value && Number.isFinite(minSecond)) {
                    const c = getIraDateTimeMinutes(date2.value, slot);
                    disabled = !Number.isFinite(c) || c < minSecond;
                }
                return `<option value="${slot}"${disabled ? " disabled" : ""}>${slot}</option>`;
            })).join("");
        const stillValid = Array.from(time2.options).some(o => o.value === prev && !o.disabled);
        time2.value = stillValid ? prev : "";
    }

